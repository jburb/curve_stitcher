{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StitchLab",
  "version": "0.1.0",
  "identifier": "com.stitchlab.app",
  "build": {
    "frontendDist": "..",
    "devUrl": "http://127.0.0.1:4173/stitchlab.html",
    "beforeDevCommand": "python3 -m http.server 4173 --bind 127.0.0.1",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "StitchLab",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
